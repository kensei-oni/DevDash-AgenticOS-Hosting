# Copy to .env for local development. Production values live in /etc/devdash/devdash.env (see deploy/install.sh).

# Public URL of this space, exactly as the browser sees it (no trailing slash).
DEVDASH_ORIGIN=http://localhost:5173
DEVDASH_SPACE_NAME=DevDash
DEVDASH_DATA_DIR=./data
DEVDASH_PORT=8787

# 32 random bytes, base64. Encrypts 2FA secrets at rest. Losing it locks everyone out of 2FA.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEVDASH_MASTER_KEY=

# 1 only when the origin is reachable exclusively through Cloudflare (trusts CF-Connecting-IP).
DEVDASH_TRUST_CF_IP=0

# Hosting (agOS Hosting page + Claude's hosting_* tools): the bundled Dokploy in apps/hosting, installed by
# deploy/hosting-install.sh. Its ports never collide with DevDash: Dokploy 3010, Traefik 8880/8843.
DEVDASH_HOSTING_URL=http://127.0.0.1:3010
# Dokploy > Settings > API Keys. Empty: the Hosting page shows setup steps.
DEVDASH_HOSTING_API_KEY=
# Optional: base domain with a wildcard DNS record to this server; apps get <name>.<domain>.
DEVDASH_HOSTING_DOMAIN=
# Optional: where members open Dokploy's own dashboard (https://<space>:3443 after the installer).
DEVDASH_HOSTING_DASHBOARD_URL=

